---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Contact — Avietho Digital">
  <!-- Main container -->
  <main class="max-w-7xl mx-auto px-6 md:px-12 pt-4 pb-12 font-body">

    <!-- HERO / AGENCY BANNER SECTION -->
    <section class="relative overflow-hidden rounded-3xl pt-6 pb-8 px-8 md:pt-8 md:pb-12 md:px-12 mb-12 shadow-2xl backdrop-blur-md">
      <!-- Glow effect backdrop -->
      <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <!-- HEADER TAGLINE -->
        <div class="inline-flex items-center gap-3 text-xs md:text-sm font-semibold tracking-[0.2em] uppercase text-accent mb-4">
          <span class="w-8 h-[1px] bg-accent/60"></span>
          <span>Advertise · Growth · Strategy · Partnerships</span>
        </div>

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-heading font-bold tracking-tight text-foreground leading-[1.05]">
          Let’s scale your <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-hover italic">digital footprint.</span>
        </h1>

        <p class="mt-4 text-lg md:text-xl text-text-subtle font-heading max-w-xl leading-relaxed">
          Interested in advertising, collaboration, or performance marketing opportunities? Tell us what you are building — the Avietho strategist desk reads every brief, and we respond promptly.
        </p>
      </div>

      <!-- Quick Agency Stats / Contact Strip (FULL WIDTH GRID) -->
      <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-8 mt-8 border-t border-border/80">
        
        <!-- Landline -->
        <div class="bg-surface/50 border border-border/60 p-4 lg:p-5 rounded-2xl flex flex-col justify-between hover:border-accent/40 transition">
          <div class="text-[11px] lg:text-xs uppercase tracking-widest text-text-muted mb-2 font-semibold whitespace-nowrap">
            Landline
          </div>
          <a href="tel:+63270001366" class="text-sm lg:text-base font-heading font-bold text-foreground hover:text-accent transition whitespace-nowrap">
            +63 2 7000 1366
          </a>
        </div>

        <!-- Mobile -->
        <div class="bg-surface/50 border border-border/60 p-4 lg:p-5 rounded-2xl flex flex-col justify-between hover:border-accent/40 transition">
          <div class="text-[11px] lg:text-xs uppercase tracking-widest text-text-muted mb-2 font-semibold whitespace-nowrap">
            Mobile
          </div>
          <a href="tel:+6397831987" class="text-sm lg:text-base font-heading font-bold text-foreground hover:text-accent transition whitespace-nowrap">
            +63 9783 1987
          </a>
        </div>

        <!-- General Inquiries -->
        <div class="bg-surface/50 border border-border/60 p-4 lg:p-5 rounded-2xl flex flex-col justify-between hover:border-accent/40 transition min-w-0">
          <div class="text-[11px] lg:text-xs uppercase tracking-widest text-text-muted mb-2 font-semibold whitespace-nowrap">
            General Inquiries
          </div>
          <a href="mailto:marketing.avietho@gmail.com" class="text-xs lg:text-[13px] font-heading font-bold text-foreground hover:text-accent transition whitespace-nowrap overflow-hidden text-ellipsis" title="marketing.avietho@gmail.com">
            marketing.avietho@gmail.com
          </a>
        </div>

        <!-- Marketing & Partnerships -->
        <div class="bg-surface/50 border border-border/60 p-4 lg:p-5 rounded-2xl flex flex-col justify-between hover:border-accent/40 transition min-w-0">
          <div class="text-[11px] lg:text-xs uppercase tracking-widest text-text-muted mb-2 font-semibold whitespace-nowrap">
            Marketing & Partnerships
          </div>
          <a href="mailto:aviethodigital@gmail.com" class="text-xs lg:text-[13px] font-heading font-bold text-foreground hover:text-accent transition whitespace-nowrap overflow-hidden text-ellipsis" title="aviethodigital@gmail.com">
            aviethodigital@gmail.com
          </a>
        </div>

      </div>
    </section>

    <!-- MAIN INTERACTIVE SECTION -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT COLUMN: AGENCY BRIEF FORM PANEL -->
      <div class="lg:col-span-7 bg-background-elevated/60 border border-border rounded-3xl p-8 shadow-xl backdrop-blur-md flex flex-col justify-between">
        
        <div>
          <!-- PILL OBJECTIVE SELECTORS WITH INTERACTIVE TOGGLE -->
          <div class="mb-8">
            <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-semibold text-accent mb-4">
              <span class="w-6 h-[1px] bg-accent"></span>
              <span>Inquiry Type</span>
            </div>
            <div class="flex flex-wrap gap-2" id="inquiry-pills">
              <button type="button" class="inquiry-btn active border border-accent bg-accent text-background font-semibold px-4 py-2 hover:border-accent hover:text-foreground rounded-full text-xs tracking-wider uppercase transition shadow-md shadow-accent/20">
                Digital PR
              </button>
              <button type="button" class="inquiry-btn border border-border bg-surface/50 text-text-subtle font-semibold hover:border-accent hover:text-foreground px-4 py-2 rounded-full text-xs tracking-wider uppercase transition">
                Video & Livestreaming Services
              </button>
              <button type="button" class="inquiry-btn border border-border bg-surface/50 text-text-subtle font-semibold hover:border-accent hover:text-foreground px-4 py-2 rounded-full text-xs tracking-wider uppercase transition">
                Web Development
              </button>
              <button type="button" class="inquiry-btn border border-border bg-surface/50 text-text-subtle font-semibold hover:border-accent hover:text-foreground px-4 py-2 rounded-full text-xs tracking-wider uppercase transition">
                Digital & Social Media Marketing
              </button>
              <button type="button" class="inquiry-btn border border-border bg-surface/50 text-text-subtle font-semibold hover:border-accent hover:text-foreground px-4 py-2 rounded-full text-xs tracking-wider uppercase transition">
                Multimedia & Branding
              </button>
            </div>
          </div>

          <!-- FORM FIELDS -->
          <form id="contact-form" class="space-y-6" autocomplete="off" method="POST">
            
            <!-- Hidden input to store selected Pill Option for EmailJS -->
            <input type="hidden" name="inquiry_type" id="selected-inquiry" value="Digital PR" />

            <!-- Hidden dummy inputs to trick Chrome/Safari autofill engines -->
            <input type="text" style="display:none" name="fake_usernameremembered"/>
            <input type="password" style="display:none" name="fake_passwordremembered"/>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-text-subtle mb-1">
                  First Name <span class="text-accent">*</span>
                </label>
                <input 
                  type="text" 
                  name="first_name" 
                  required 
                  autocomplete="one-time-code"
                  class="manual-input w-full bg-transparent border-b border-border/80 rounded-none py-2 text-foreground placeholder:text-text-muted/40 focus:border-accent focus:outline-none transition" 
                />
              </div>
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-text-subtle mb-1">
                  Last Name <span class="text-accent">*</span>
                </label>
                <input 
                  type="text" 
                  name="last_name" 
                  required 
                  autocomplete="one-time-code"
                  class="manual-input w-full bg-transparent border-b border-border/80 rounded-none py-2 text-foreground placeholder:text-text-muted/40 focus:border-accent focus:outline-none transition" 
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-text-subtle mb-1">
                  Work Email <span class="text-accent">*</span>
                </label>
                <input 
                  type="email" 
                  name="user_email" 
                  required 
                  autocomplete="one-time-code"
                  class="manual-input w-full bg-transparent border-b border-border/80 rounded-none py-2 text-foreground placeholder:text-text-muted/40 focus:border-accent focus:outline-none transition" 
                />
              </div>

              <!-- STRICT NUMERIC-ONLY PHONE NUMBER INPUT -->
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-text-subtle mb-1">Phone Number</label>
                <input 
                  type="tel" 
                  id="phone-input"
                  name="contact_number" 
                  maxlength="11"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  autocomplete="one-time-code"
                  onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                  oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                  class="manual-input w-full bg-transparent border-b border-border/80 rounded-none py-2 text-foreground placeholder:text-text-muted/40 focus:border-accent focus:outline-none transition" 
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-text-subtle mb-1">Company / Brand Website</label>
              <input 
                type="text" 
                name="organization" 
                autocomplete="one-time-code"
                class="manual-input w-full bg-transparent border-b border-border/80 rounded-none py-2 text-foreground placeholder:text-text-muted/40 focus:border-accent focus:outline-none transition" 
              />
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-text-subtle mb-1">Your Message</label>
              <textarea name="message" required rows="3" placeholder="Tell us about your goals, timeline, or project brief..." class="w-full bg-transparent border-b border-border/80 rounded-none py-2 text-foreground placeholder:text-text-muted/40 focus:border-accent focus:outline-none transition resize-none"></textarea>
            </div>

            <!-- FORM FOOTER & SUBMIT BUTTON -->
            <div class="pt-6 mt-6 flex flex-col sm:flex-row items-center justify-between gap-6 border-border/60">
              <span class="text-xs uppercase tracking-wider font-semibold text-text-subtle max-w-xs leading-relaxed">
                By submitting, you agree to our Privacy Policy and Terms of Service.
              </span>
              <button type="submit" id="submit-btn" class="w-full sm:w-auto bg-gradient-to-r from-accent to-accent-hover text-background font-bold text-xs uppercase tracking-widest px-8 py-4 rounded-xl hover:opacity-90 transition shadow-lg shadow-accent/10">
                Send Message
              </button>
            </div>
          </form>

          <!-- STATUS DISPLAY -->
          <p id="form-status" class="mt-4 text-xs font-semibold text-center"></p>
        </div>

      </div>

      <!-- RIGHT COLUMN: HQ & DIRECT CONTACT -->
      <div class="lg:col-span-5 lg:sticky lg:top-20 self-start">
        
        <div id="sticky-sidebar" class="flex flex-col justify-start gap-2 p-3 md:p-5 origin-top transition-all duration-300 ease-out">
          
          <!-- HQ OFFICE -->
          <div class="flex flex-col items-start w-full">
            <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-accent mb-2.5">
              <span class="w-6 h-[1px] bg-accent"></span>
              <span>Headquarters</span>
            </div>

            <h2 class="text-2xl md:text-[1.7rem] font-heading font-bold text-foreground mb-3 leading-snug">
              Madrigal Business Park, <br/>
              <span class="text-accent italic font-normal">Ayala Alabang.</span>
            </h2>

            <!-- UNIFORM FONT WEIGHT ADDRESS BLOCK -->
            <address class="not-italic text-text-subtle text-sm font-heading leading-relaxed flex flex-col items-start gap-[4.2px]">
              <span>Admiralty Bldg. 1101</span>
              <span>Alabang-Zapote Rd.</span>
              <span>Madrigal Business Park</span>
              <span>Brgy. Ayala Alabang</span>
              <span>Muntinlupa City, Philippines</span>
            </address>
          </div>

          <!-- VIEW OUR LOCATION - Opens in a new tab -->
          <div class="flex items-center my-3 py-2">
            <a 
              href="https://maps.app.goo.gl/KyDMwmYMADs5c5LC7" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 text-sm md:text-base font-semibold uppercase tracking-wider text-foreground hover:text-accent transition"
            >
              <span>View Our Location</span>
              <span>↗</span>
            </a>
          </div>

          <!-- DIRECT LINES -->
          <div class="space-y-3 flex flex-col justify-center pt-2">
            <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-accent mb-1.5">
              <span class="w-6 h-[1px] bg-accent"></span>
              <span>Direct Strategy Lines</span>
            </div>

            <div class="space-y-1">
              <div class="group flex justify-between items-center py-2.5 border-b border-border/60 text-sm">
                <span class="text-xs uppercase tracking-wider text-text-muted">Landline</span>
                <a href="tel:+63270001366" class="font-heading text-xs md:text-sm font-normal text-foreground group-hover:font-bold group-hover:text-accent transition-all duration-150">
                  +63 2 7000 1366
                </a>
              </div>

              <div class="group flex justify-between items-center py-2.5 border-b border-border/60 text-sm">
                <span class="text-xs uppercase tracking-wider text-text-muted">Mobile</span>
                <a href="tel:+6397831987" class="font-heading text-xs md:text-sm font-normal text-foreground group-hover:font-bold group-hover:text-accent transition-all duration-150">
                  +63 9783 1987
                </a>
              </div>

              <div class="group flex justify-between items-center py-2.5 border-b border-border/60 text-sm">
                <span class="text-xs uppercase tracking-wider text-text-muted">General</span>
                <a href="mailto:aviethodigital@gmail.com" class="font-heading text-xs md:text-sm font-normal text-foreground group-hover:font-bold group-hover:text-accent transition-all duration-150 truncate max-w-[210px]">
                  aviethodigital@gmail.com
                </a>
              </div>

              <div class="group flex justify-between items-center py-2.5 border-b border-border/60 text-sm">
                <span class="text-xs uppercase tracking-wider text-text-muted">Marketing</span>
                <a href="mailto:marketing.avietho@gmail.com" class="font-heading text-xs md:text-sm font-normal text-foreground group-hover:font-bold group-hover:text-accent transition-all duration-150 truncate max-w-[210px]">
                  marketing.avietho@gmail.com
                </a>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main>

</BaseLayout>

<!-- SCRIPT FOR UI TOGGLES, SCROLL ANIMATION & STRICT AUTOFILL CLEARING -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Force clear inputs on load to prevent cached values
    const manualInputs = document.querySelectorAll<HTMLInputElement>('.manual-input');
    manualInputs.forEach((input) => {
      input.value = '';
    });

    // 2. Strict Keydown Handling for Phone Input (Prevents typing letters)
    const phoneInput = document.getElementById('phone-input') as HTMLInputElement | null;
    if (phoneInput) {
      phoneInput.addEventListener('keydown', (e: KeyboardEvent) => {
        // Allow navigation/editing keys
        const allowed = ['Backspace', 'Delete', 'Tab', 'Escape', 'Enter', 'ArrowLeft', 'ArrowRight', 'Home', 'End'];
        if (allowed.includes(e.key) || e.ctrlKey || e.metaKey) {
          return;
        }
        // Block any key that is not a digit (0-9)
        if (!/^[0-9]$/.test(e.key)) {
          e.preventDefault();
        }
      });
    }

    // 3. Inquiry Pill Selection Handling & Hidden Input Syncing
    const buttons = document.querySelectorAll('.inquiry-btn');
    const hiddenInput = document.getElementById('selected-inquiry') as HTMLInputElement | null;
    const inactiveClasses = ['border-border', 'bg-surface/50', 'text-text-subtle'];
    const activeClasses = ['border-accent', 'bg-accent', 'text-background', 'shadow-md', 'shadow-accent/20'];

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Update button visual states
        buttons.forEach((b) => {
          b.classList.remove(...activeClasses);
          b.classList.add(...inactiveClasses);
        });

        btn.classList.remove(...inactiveClasses);
        btn.classList.add(...activeClasses);

        // Pass text content into hidden input field for EmailJS
        if (hiddenInput) {
          hiddenInput.value = btn.textContent?.trim() || '';
        }
      });
    });

    // 4. Smooth Downscaling Scroll Animation for HQ + Direct Comm section
    const sidebar = document.getElementById('sticky-sidebar');
    if (sidebar) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 150) {
          sidebar.classList.add('scale-95', 'opacity-95');
        } else {
          sidebar.classList.remove('scale-95', 'opacity-95');
        }
      }, { passive: true });
    }
  });
</script>

<script>
  import emailjs from '@emailjs/browser';

  const publicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;
  const serviceId = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
  const templateId = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;

  // Initialize EmailJS
  if (publicKey) {
    emailjs.init(publicKey);
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const statusMsg = document.getElementById('form-status') as HTMLParagraphElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!serviceId || !templateId) {
      if (statusMsg) {
        statusMsg.textContent = "Configuration error: Missing EmailJS keys.";
        statusMsg.className = "status-msg error";
      }
      return;
    }

    // Indicate sending state
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }
    if (statusMsg) {
      statusMsg.textContent = '';
    }

    try {
      await emailjs.sendForm(serviceId, templateId, form);
      if (statusMsg) {
        statusMsg.textContent = '✓ Message sent successfully!';
        statusMsg.className = 'status-msg success';
      }
      form.reset();

      // Reset hidden input back to default pill value after form reset
      const hiddenInput = document.getElementById('selected-inquiry') as HTMLInputElement | null;
      if (hiddenInput) {
        hiddenInput.value = "Digital PR";
      }

      // Reset visual pill active state back to first pill
      const buttons = document.querySelectorAll('.inquiry-btn');
      const inactiveClasses = ['border-border', 'bg-surface/50', 'text-text-subtle'];
      const activeClasses = ['border-accent', 'bg-accent', 'text-background', 'shadow-md', 'shadow-accent/20'];
      
      buttons.forEach((btn, index) => {
        if (index === 0) {
          btn.classList.remove(...inactiveClasses);
          btn.classList.add(...activeClasses);
        } else {
          btn.classList.remove(...activeClasses);
          btn.classList.add(...inactiveClasses);
        }
      });

      // Automatically hide status message after 2 seconds
      setTimeout(() => {
        if (statusMsg) {
          statusMsg.textContent = '';
          statusMsg.className = 'mt-4 text-xs font-semibold text-center';
        }
      }, 2000);

    } catch (error) {
      if (statusMsg) {
        statusMsg.textContent = '✕ Failed to send message. Please try again.';
        statusMsg.className = 'status-msg error';
      }
      console.error('EmailJS Error:', error);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Email';
      }
    }
  });
</script>